    \onslide<2->{\node[lblob] (0) at (0,0) {\strut\only<2-16|handout:1->{$*$}\only<17-|handout:0>{25}};
    \onslide<2-16|handout:1->{\node[lblob] (1) at (-1.5,-1) {\only<2-15|handout:1->{$+$}\only<16-|handout:0>{5}};}
    \onslide<2-16|handout:1->{\node[lblob] (2) at (1.5,-1) {5};}
    \onslide<2-15|handout:1->{\node[lblob] (3) at (-2.5,-2) {2};}
    \onslide<2-15|handout:1->{\node[lblob] (4) at (-.5,-2) {3};}
    \onslide<2-16|handout:1->{\graph[edges={very thick,lgray,-Kite}]{(0) -> (1), (0) -> (2)};}
    \onslide<2-15|handout:1->{\graph[edges={very thick,lgray,-Kite}]{(1) -> (3), (1) -> (4)};}
    \node[below=4mm,font=\sffamily\footnotesize] at (current bounding box.south) {An arithmetic \only<2-16|handout:1->{tree}\only<17-|handout:0>{treat}!};}
\end{tikzpicture}}\\[1.25ex]
\lstfs{8}%
\begin{uncoverenv}<3->
\begin{plainjava}
    class Node {
        Node left, right;
        int data; String op;
    }
\end{plainjava}
\end{uncoverenv}
\end{column}
\begin{column}{.575\linewidth}
\begin{uncoverenv}<5->
\lstfs{8}%
\begin{plainjava}[aboveskip=0pt,belowskip=0pt,escapeinside={!}{!}]
!\onslide<5->!long postOrderEval(Node node) {
!\onslide<6->!    if(node == null) throw new /* ... */;
!\mdl[1]{13}\onslide<7->!    if(node.op == null) // no operation
!\mdl[1]{13}\onslide<7->!        return node.data;
!\mdl[2]{14}\onslide<8->!    long l = postOrderEval(node.left);
!\mdl[2]{14}\onslide<8->!    long r = postOrderEval(node.right);
!\mdl[2]{14}\onslide<9->!    switch(node.op) {
!\mdl[2]{14}\onslide<9->!        case "+": !\onslide<10->!return l + r;
!\mdl[2]{14}\onslide<9->!        case "*": !\onslide<11->!return l * r;
!\mdl[2]{14}\onslide<12->!        // ... other cases, errors, ...
!\mdl[2]{14}\onslide<9->!    }
!\onslide<5->!}
\end{plainjava}
\end{uncoverenv}\onslide<1->
\end{column}
\end{columns}

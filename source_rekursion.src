        \end{column}
    \end{columns}
\begin{tikzpicture}[overlay,remember picture]
    \onslide<2->{%
        \node[below left=.25cm,yshift=.8cm,scale=.6] (pingu) at (current page.north east) {\rotatebox[origin=c]{180}{\usebox\pinguB}};

\SidebarCite{dive:recursionvsit}
\begin{frame}{A Few Notes}
\begin{itemize}[<+(1)->]
    \itemsep13pt
    \item The examples shown were kept as minimal as possible
    \item The variants can be combined!\pause{}\smallskip\par
        \faAngleRight\ e.g. a cascading, mutual recursion.
    \item Recursion and iteration are usually equally powerful.
\end{itemize}
\end{frame}
\SidebarReset

\subsection{Head vs. Tail Recursion}
\savebox\pinguA{\tikz{\pingu[right wing grab, sunglasses round=brown!65!black,eyes shiny]}}%
\savebox\pinguB{\tikz{\pingu[wings shock, sunglasses round=brown!65!black, eyes angry,devil horns=paletteA]}}%
\begin{frame}[fragile]{Head vs. Tail Recursion}
\pause\lstfs{8}\begin{columns}[c]
        \begin{column}{.425\linewidth}
\centering
\begin{plainjava}[escapeinside={!}{!}]
!\md{3}!void h(int n) {
!\md{7}!    if(n <= 0) return;
!\md{4-6}!    h(n - 1);
!\md{8,10,12}!    System.out.println(n);!\mh[1]{9,11,13-14}!
}
\end{plainjava}
\resizebox{.8\linewidth}!{\begin{tikzpicture}[lblob/.append style={text=black,scale=.8},xscale=1.33]
    \onslide<3->{\node[lblob] (3) at(0,0) {h(3)};}
    \onslide<5->{\node[lblob] (2) at(1,0) {h(2)}; \draw[lgray,thick,-Kite] (3) -- (2);}
    \onslide<6->{\node[lblob] (1) at(2,0) {h(1)}; \draw[lgray,thick,-Kite] (2) -- (1);}
    \onslide<7->{\node[lblob] (0) at(3,0) {h(0)}; \draw[lgray,thick,-Kite] (1) -- (0);}
    \onslide<8-|handout:1>{\draw[lgray,thick,-Kite] (0.110) to[bend right] (1.70);}
    \onslide<9-|handout:1>{\node[below,gray,scale=.8] at(1.south) {1};}
    \onslide<10-|handout:1>{\draw[lgray,thick,-Kite] (1.110) to[bend right] (2.70);}
    \onslide<11-|handout:1>{\node[below,gray,scale=.8] at(2.south) {2};}
    \onslide<12-|handout:1>{\draw[lgray,thick,-Kite] (2.110) to[bend right] (3.70);}
    \onslide<13-|handout:1>{\node[below,gray,scale=.8] at(3.south) {3};}

    \onslide<14-|handout:1>{
        \node[below=5mm] at(current bounding box.south) {Output:  \T{1} \(\to\) \T{2} \(\to\) \T{3}};
    }
\end{tikzpicture}}
        \end{column} \begin{column}{.425\linewidth}
\centering
\begin{plainjava}[escapeinside={!}{!}]
!\md{3}!void t(int n) {
!\md{10}!    if(n <= 0) return;
!\md{4-5,7,9}!    System.out.println(n);
    !\mb{6,8}!t(n - 1);!\mh[1]{11-14}!
}
\end{plainjava}
\resizebox{.8\linewidth}!{\begin{tikzpicture}[lblob/.append style={text=black,scale=.8},xscale=1.33]
    \onslide<3->{\node[lblob] (3) at(0,0) {t(3)};}
    \onslide<5->{\node[below,gray,scale=.8] at(3.south) {3};}
    \onslide<6->{\node[lblob] (2) at(1,0) {t(2)}; \draw[lgray,thick,-Kite] (3) -- (2);}
    \onslide<7->{\node[below,gray,scale=.8] at(2.south) {2};}
    \onslide<8->{\node[lblob] (1) at(2,0) {t(1)}; \draw[lgray,thick,-Kite] (2) -- (1);}
    \onslide<9->{\node[below,gray,scale=.8] at(1.south) {1};}
    \onslide<10->{\node[lblob] (0) at(3,0) {t(0)}; \draw[lgray,thick,-Kite] (1) -- (0);}
    \onslide<11-|handout:1>{\draw[lgray,thick,-Kite] (0.110) to[bend right] (1.70);}
    \onslide<12-|handout:1>{\draw[lgray,thick,-Kite] (1.110) to[bend right] (2.70);}
    \onslide<13-|handout:1>{\draw[lgray,thick,-Kite] (2.110) to[bend right] (3.70);}
    \onslide<14-|handout:1>{
        \node[below=5mm] at(current bounding box.south) {Output: \T{3} \(\to\) \T{2} \(\to\) \T{1}};
    }
\end{tikzpicture}}
        \end{column}
    \end{columns}
\begin{tikzpicture}[overlay,remember picture]
    \onslide<15-|handout:1>{%
        \node[below left=.25cm,yshift=.8cm,scale=.6] (pingu) at (current page.north east) {\rotatebox[origin=c]{180}{\usebox\pinguA}};
        \node[left,scale=.6,text width=6.75cm,align=center,yshift=-.33cm] at (pingu.west) {In short: does something still happen on the way back up the recursion or not (tail).};
    }
    \onslide<16-|handout:1>{%
        \node[above right=-.66cm,scale=.6] (pingu) at (current page.south west) {\rotatebox[origin=c]{-45}{\usebox\pinguB}};
        \node[above=1.5mm,scale=.5,gray,text width=5.5cm,align=center,yshift=-.33cm] at (pingu.north east) {Disclaimer: the subtleties of head recursion are neglected here. Tail recursion is more interesting because it can be transformed into iteration without any trouble.};
    }
\end{tikzpicture}%
\end{frame}

\section{Examples}
\subsection{Mathematical Functions}
\subsubsection{The Factorial Function}
\savebox\pinguA{\tikz{\pingu[right eye wink,sign post left={\textbf{Note!}},right wing shock,left wing hug]}}%
\begin{frame}[fragile]{Mathematical Functions}
\begin{itemize}[<+(1)->]
    \itemsep4pt
    \item Some mathematical functions are defined recursively.
    \item The given definition can usually be translated 1:1.
    \item It already takes a good deal of the thinking off your hands.
\end{itemize}
\begin{columns}[c]
\begin{column}{.425\linewidth}
\footnotesize\onslide<5->{\begin{align*}
    f(n) &= \begin{cases}
        1,\quad & n \leq 1 \\
        n \cdot \only<5|handout:1>{\text{\hspace*{-2pt}\tikz[baseline=-.45ex]{\node[fill=shadeA,rounded corners=2pt,outer sep=0pt,inner xsep=0pt,inner ysep=1.5pt] {\hspace*{2pt}$f(n - 1)$\hspace*{2pt}};}\hspace*{-2pt}}}\only<6-|handout:0>{f(n - 1)},\quad & n > 1
    \end{cases}\\[1ex]
    \color{gray}f_n &\color{gray}:~ \N \to \N, n \mapsto n \cdot \only<5|handout:1>{\text{\hspace*{-2pt}\tikz[baseline=-.45ex]{\node[fill=shadeA!40!white,rounded corners=2pt,outer sep=0pt,inner xsep=0pt,inner ysep=1pt] {\hspace*{2pt}$f_{n - 1}$\hspace*{2pt}};}\hspace*{-2pt}}}\only<6-|handout:0>{f_{n - 1}} \\
        & \color{gray}f_1 = 1
\end{align*}}
\end{column} \begin{column}{.475\linewidth}\lstfs{9}
\begin{plainjava}
!*\onslide<6->*!public int f(int n) {
!*\onslide<7->*!  if(n <= 1) return 1;
!*\onslide<8->*!  else return n * f(n - 1);
!*\onslide<6->*!}
\end{plainjava}
\vspace*{1.5em}
\end{column}
\end{columns}
\begin{tikzpicture}[remember picture,overlay]
    \onslide<9->{%
        \node[above right=.25cm,yshift=1cm,scale=.6] (pingu) at (current page.south west) {\usebox\pinguA};
        \node[above=1mm,scale=.6,text width=4.5cm,align=center,font=\footnotesize\sffamily] at(pingu.north) {%
            \say{Elemental problems} are the non-recursive cases here: parts of the sequence that are often given axiomatically.%
        };
    }
\end{tikzpicture}
\end{frame}

\subsubsection{The Ackermann Function}
\savebox\pinguA{\tikz{\pingu[wings wave, straw hat,belly=\Large\faCode,sunglasses, glasses opacity=.9]}}%
\savebox\pinguB{\lstfs{8}%
\begin{minipage}{5cm}
\begin{plainjava}^^J
int f(int n) \{^^J
{} {} {} {}return phi(n, n, n);^^J
\}^^J
^^J
int alpha(int a, int n) \{^^J
{} {} {} {}return n <= 1 ? n : a;^^J
\}^^J
\end{plainjava}
\end{minipage}}
\begin{frame}{The Ackermann Function, Alternative\hfill \textcolor{shadeA}{\textbf{I}}}
\centering\begin{align*}
    \onslide<2->{f(n) &= \phi(n, n, n)}\\[1ex]
    \onslide<3->{\phi(a, b, 0) &= a + b }\\
    \onslide<3->{\phi(a, 0, n) &= \alpha(a, n - 1)} \\
    \onslide<3->{\phi(a, b, n) &= \phi(a, \phi(a, b - 1, n), n - 1)} \\[1ex]
    \onslide<4->{\alpha(a, n) &= \begin{cases}
        0, \quad &\text{ if } n = 0 \\
        1, \quad &\text{ if } n = 1 \\
        a, \quad &\text{ if } n > 1
    \end{cases}}
\end{align*}
\begin{tikzpicture}[remember picture,overlay]
    \onslide<5->{%
        \node[above right=.25cm,yshift=1cm,scale=.6] (pingu) at (current page.south west) {\usebox\pinguA};
        \node[above=1mm,xshift=.85cm,scale=.75,text width=4.5cm,align=left,font=\footnotesize\sffamily] at(pingu.north) {\usebox\pinguB};
    }
\end{tikzpicture}
\end{frame}

\begin{frame}[c,fragile]{The Ackermann Function, Alternative\hfill \textcolor{shadeA}{\textbf{II}}}
\centering
\begin{plainjava}
!*\onslide<2->*!int phi(int a, int b, int n) {
!*\onslide<4->*!    if(n == 0) return a + b;
!*\onslide<5->*!    else if (b == 0) return alpha(a, n - 1);
!*\onslide<6->*!    else return phi(a, phi(a, b - 1, n), n - 1);
!*\onslide<2->*!}
\end{plainjava}
\begin{tikzpicture}[remember picture,overlay]
    \onslide<3-|handout:0>{\node[above left=.5cm,yshift=1,font=\scriptsize\sffamily,gray,xshift=-.33cm,text width=5cm] at(current page.south east) {\begin{align*}
        \phi(a, b, 0) &= a + b \\
        \phi(a, 0, n) &= \alpha(a, n - 1) \\
        \phi(a, b, n) &= \phi(a, \phi(a, b - 1, n), n - 1)
    \end{align*}};}

    \onslide<7->{
        \node[above right=.5cm,yshift=1.33cm,xshift=2.75cm] (xms) at (current page.south west) {%
            \bjava{f(1) = 1}\only<8->{, \bjava{f(2) = 4}}\only<9->{, \bjava{f(3) =\ }\faFlash}
        };
        \onslide<10->{
            \node[below left,yshift=1mm] at(xms.south east) {
                \tiny\color{gray}\(\gtrsim 2 \uparrow^2 7 \approx 10^{10^{10^{19\,000}}}\)
            };
        }
    }
\end{tikzpicture}
\end{frame}
\subsection{Recursive Structures}
\savebox\pinguA{\tikz{\pingu[wings wave, left eye devil=paletteA,right eye wink,large,hat=paletteA]}}%
\savebox\pinguB{%
\begin{minipage}{5cm}
\begin{plainjava}[morekeywords={[3]{T}}]^^J
class Node<T> \{^^J
\ \ Node left;^^J
\ \ Node right;^^J
\ \ T data;^^J
\}^^J
\end{plainjava}
\end{minipage}}%
\begin{frame}[fragile]{Recursive Structures}
\begin{center}% two allows for better folding :D
\begin{columns}[c]
\begin{column}{.55\linewidth}
\centering\scalebox{.65}{\begin{tikzpicture}
    \onslide<2->{\node[lblob] (0) at (0,0) {};
    \node[lblob={fill=shadeA, draw=shadeA}] (1) at (-1.5,-1) {};
    \node[lblob] (2) at (1.5,-1) {};
    \node[lblob] (3) at (-2.5,-2) {};
    \node[lblob] (4) at (-.5,-2) {};
    \graph[edges={very thick,lgray,-Kite}]{(0) -> (1), (0) -> (2)};
    \graph[edges={very thick,shadeA,-Kite}]{(1) -> (3), (1) -> (4)};
    \node[below=4mm,font=\sffamily\footnotesize] at (current bounding box.south) {Every node is the root of a subtree};}
\end{tikzpicture}}
\end{column} \begin{column}{.35\linewidth}\lstfs{8}%
\begin{plainjava}[aboveskip=-10pt]
!*\onslide<3->*!class Node {
!*\onslide<3->*!    Node left;
!*\onslide<3->*!    Node right;
!*\onslide<3->*!    int data;
!*\onslide<3->*!}
\end{plainjava}

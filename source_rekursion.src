\begin{plainjava}
!*\md{12,18,28,45}\onslide<3->*!boolean nQueens(boolean[][] board, int row) {
!*\md{13,19,29,46}\onslide<4->*!    if(row == board.length) return true;
!*\md{14,20,22,24,30,32,34,36,41,47}\onslide<5->*!    for (int column = 0; column < board.length; column++) {
!*\md{15,21,23,25,31,33,35,37,42,48}\onslide<6->*!        if(!queenCanBePlacedHere(board, column, row)) continue;
!*\md{16,26,43}\onslide<7->*!        board[row][column] = true; // Try to place queen here
!*\onslide<8->*!        if(!*\mh{17,27,44}*!nQueens(board, row + 1)!*\mh{39}*!)
!*\onslide<8->*!            return true;!*\mh[1]{50}*!
!*\onslide<9->\md{40}*!        board[row][column] = false;
!*\onslide<5->*!    }
!*\onslide<10->\md{38}*!    return false;
!*\onslide<3->*!}
\end{plainjava}
\end{frame}

\subsubsection{Sorting}
\begin{frame}[fragile]{Recursive Sorting\hfill{\color{shadeA}\footnotesize\sbfamily Quicksort}}\lstfs{8}
\begin{plainjava}
!*\onslide<2->*!void quicksort(int[] arr) {
!*\onslide<3->*!    quicksort(arr, 0, arr.length - 1);
!*\onslide<2->*!}
!*\onslide<2->*!
!*\onslide<4->*!void quicksort(int[] arr, int left, int right) {
!*\onslide<5->*!    if(low >= right) return;
!*\onslide<6->*!    int partIndex = partition(arr, left, right);!*\tikzmark{partitionfunc}*!
!*\onslide<7->*!    quicksort(arr, left, partIndex - 1);
!*\onslide<7->*!    quicksort(arr, partIndex + 1, right);
!*\onslide<4->*!}
\end{plainjava}
\begin{tikzpicture}[overlay,remember picture]
\onslide<8->{\node[below right,xshift=1cm,gray,scale=.55,text width=4cm] (bzt) at (pic cs:partitionfunc) {%
    Picks a pivot and sorts everything smaller than the pivot to the left and everything greater or equal to the right.%
};
\draw[lgray,thick,-Kite] (bzt.north west) to[out=135,in=0] (pic cs:partitionfunc);}
\end{tikzpicture}
\end{frame}

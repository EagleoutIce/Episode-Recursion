        \onslide<28-38,45-49|handout:0>{ \node[lblock,scale=.75,inner sep=1pt] (q2) at (-6.75,.5) {\bjava{q(board, 2)}}; \draw[lgray,thick,-Kite] (q1) -- (q2); }
        \onslide<49|handout:0>{\fill[lgray,fill opacity=.42,rounded corners=4pt] (1.25,-1.25) rectangle (-8.5,4.25) node[midway,centered,text=black] {\huge\textbf{\ldots}};}

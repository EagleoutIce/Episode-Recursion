\onslide<10-|handout:1->{\node[lblock] (l4) at (2,0) {\T{a(0, 2)}};
\draw[lgray,thick,-Kite] (l1.east) -- (l4.west);}
\onslide<11-|handout:2->{\node[right,gray,scale=.65] at(l4.east) {3};}

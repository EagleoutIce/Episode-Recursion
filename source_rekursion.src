\savebox\pinguC{%
\begin{minipage}{5cm}%
\begin{plainjava}[morekeywords={[3]{Pole}}]^^J
enum Pole \{^^J
\ \ SOURCE,^^J
\ \ HELPER,^^J
\ \ TARGET^^J
\}^^J
\end{plainjava}
\end{minipage}}%
\begin{frame}[fragile]{The Towers of Hanoi}
\begin{tikzpicture}[remember picture,overlay]
    \onslide<2->{\node[below left=.33cm] at (current page.north east) {\usebox\pinguA};}
    \onslide<7->{%
        \node[above right=.25cm,yshift=1cm,scale=.6] (pingu) at (current page.south west) {\usebox\pinguB};
        \node[above=1mm,xshift=.85cm,scale=.75,text width=4.5cm,align=left,font=\footnotesize\sffamily] at(pingu.north) {\usebox\pinguC};
    }
    \onslide<13->{%
        \node[below right,xshift=.75cm, gray,scale=.55,text width=5.5cm,yshift=.25cm] (move-desc) at (pic cs:move-after) {%
            In the simplest case it just prints \say{$a \to c$}.%
        };
        \draw[-Kite,lgray,thick] (move-desc.178) to[out=175,in=0] ([yshift=2pt]pic cs:move-after);
    }
\end{tikzpicture}%
\scriptsize\begin{itemize}
    \item<3-> Trivial for a single disk: \(A \to C\).
    \item<4-> Otherwise: \begin{itemize}
        \item<4-> \strut\scriptsize Move \(n - 1\) disks to the helper pole: \(A \to B\).
        \item<5-> \strut\scriptsize Move the last (largest) disk from \(A \to C\).
        \item<6-> \strut\scriptsize Move \(n - 1\) disks from the helper pole to the target: \(B \to C\).
    \end{itemize}
\end{itemize}\normalsize\lstfs{7}
\begin{plainjava}[morekeywords={[3]{Pole}}, morekeywords={[4]{move}}]
!*\onslide<8->*!void hanoi(int disks, Pole a, Pole b, Pole c) {
!*\onslide<9->*!    if(disks == 1) { move(a, c);!*\tikzmark{move-after}*! }
!*\onslide<9->*!    else {
!*\onslide<10->*!        hanoi(disks - 1, a, c, b); // move all disks above to help pole
!*\onslide<11->*!        move(a, c); // move last disk to target
!*\onslide<12->*!        hanoi(disks - 1, b, a, c); // move disks from help to target pole
!*\onslide<9->*!    }
!*\onslide<8->*!}
\end{plainjava}
\end{frame}

